{
  "schema": "review-sets/1",
  "note": "Folders shown on the «Ревью» (Review) page. Files are read in place, never copied or deleted. root: relative to the repo or absolute. group '{dir}' = the file's folder name. Add your own AI-generated assets here.",
  "roots": {
    "repo": ".",
    "mine": "studio-data/review-assets"
  },
  "sets": [
    {"kind": "sticker_xerox", "root": "repo", "glob": "stacker-kit/stickers/xerox/G*/*.png", "group": "{dir}"},
    {"kind": "doc", "root": "repo", "glob": "stacker-kit/README.md", "group": "stacker"},
    {"kind": "sticker_pixel", "root": "mine", "glob": "pixel/**/*.png", "group": "{dir}"},
    {"kind": "video", "root": "mine", "glob": "videos/**/*.mp4", "group": "{dir}"},
    {"kind": "sound", "root": "mine", "glob": "sounds/**/*.wav", "group": "{dir}"}
  ]
}
